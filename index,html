<script>
(function(){
var f=document.querySelector('link[media="print"]');if(f){f.media='all';}
var rm=window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches;
document.addEventListener('click',function(e){
var a=e.target.closest&&e.target.closest('a[href^="#"]');
if(!a)return;
var id=a.getAttribute('href').slice(1);
if(!id)return;
e.preventDefault();
if(id==='top'){window.scrollTo({top:0,behavior:rm?'auto':'smooth'});return;}
var t=document.getElementById(id);
if(t){t.scrollIntoView({behavior:rm?'auto':'smooth',block:'start'});}
});
})();
(function(){
function show(u,name){
var d=document.getElementById('lk');
if(!d){
d=document.createElement('div');d.id='lk';d.setAttribute('role','dialog');
d.innerHTML='<p></p><input readonly><div class="row"><button type="button" data-a="copy">نسخ الرابط</button><button type="button" data-a="close">إغلاق</button></div>';
document.body.appendChild(d);
d.addEventListener('click',function(ev){
var b=ev.target.closest('button');if(!b)return;
if(b.getAttribute('data-a')==='close'){d.hidden=true;return;}
var i=d.querySelector('input');i.focus();i.select();
try{
if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(i.value).catch(function(){try{document.execCommand('copy');}catch(_){}});}
else{document.execCommand('copy');}
b.textContent='تم النسخ';
}catch(_){}
});
}
d.querySelector('p').textContent='المتصفح منع فتح '+name+' من هنا. انسخ الرابط وافتحه في المتصفح:';
d.querySelector('input').value=u;
d.querySelector('[data-a=copy]').textContent='نسخ الرابط';
d.hidden=false;
}
document.addEventListener('click',function(e){
var a=e.target.closest&&e.target.closest('a.soc');
if(!a)return;
e.preventDefault();
var w=null;
try{w=window.open(a.href,'_blank');}catch(_){}
if(w){try{w.opener=null;}catch(_){}return;}
show(a.href,a.textContent.trim());
});
})();
</script>
