<style>
:root{--bg:#050505;--surface:#141416;--line:#26272b;--ink:#f2f2f3;--muted:#a1a4ab;--red:#e11d2e;--red-hi:#ff3b4a;--gray:#8a8d93;--on-red:#fff;color-scheme:dark;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html{scroll-padding-top:env(safe-area-inset-top,0px);-webkit-text-size-adjust:100%}
*{box-sizing:border-box;margin:0}
body{background:radial-gradient(520px 420px at 88% 6%,rgba(225,29,46,.34),transparent 70%),radial-gradient(620px 520px at 6% 48%,rgba(138,141,147,.22),transparent 70%),radial-gradient(560px 460px at 82% 90%,rgba(225,29,46,.26),transparent 70%),var(--bg);background-repeat:no-repeat;color:var(--ink);font-family:'Cairo',system-ui,sans-serif;line-height:1.8;font-size:17px}
a{color:inherit;touch-action:manipulation;-webkit-tap-highlight-color:transparent}
:focus-visible{outline:3px solid var(--red-hi);outline-offset:3px}
.wrap{max-width:1040px;margin:0 auto;padding:0 22px}
header{display:flex;justify-content:space-between;align-items:center;padding:12px 22px;margin-top:14px;border-radius:18px;background:linear-gradient(145deg,rgba(255,255,255,.12),rgba(255,255,255,.03));border:1px solid rgba(255,255,255,.16);box-shadow:0 4px 16px rgba(0,0,0,.4),inset 0 1px 0 rgba(255,255,255,.18)}
.brand{font-weight:800;font-size:20px;text-decoration:none;letter-spacing:.14em;direction:ltr}
.brand span{color:var(--red-hi)}
nav{display:flex;gap:22px}
nav a{text-decoration:none;color:var(--muted);font-weight:600}
nav a:hover{color:var(--ink)}
.hero{text-align:center;padding:34px 0 64px;position:relative;background:radial-gradient(ellipse 50% 55% at 50% 42%,rgba(225,29,46,.3),rgba(225,29,46,0))}
.logo{position:relative;display:block;margin:0 auto;width:min(380px,78vw);height:auto}
.hero p{position:relative;max-width:30em;margin:12px auto 0;color:var(--muted);font-size:19px}
.cta{position:relative;display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:28px}
.btn{display:inline-block;background:var(--red);color:var(--on-red);font-weight:800;text-decoration:none;padding:12px 28px;border-radius:12px;border:2px solid var(--red);box-shadow:0 4px 14px rgba(225,29,46,.35)}
.btn.ghost{background:rgba(255,255,255,.08);color:var(--ink);border-color:rgba(255,255,255,.25);box-shadow:none}
.btn.ghost:hover{border-color:var(--red-hi)}
h2{font-size:30px;font-weight:800;margin-bottom:8px}
h2::after{content:"";display:block;width:48px;height:4px;background:var(--red);margin-top:6px}
.sub{color:var(--muted);margin:14px 0 28px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:18px}
.item,.vals>div{background:linear-gradient(145deg,rgba(255,255,255,.12),rgba(255,255,255,.03));border:1px solid rgba(255,255,255,.16);box-shadow:0 4px 16px rgba(0,0,0,.4),inset 0 1px 0 rgba(255,255,255,.18);border-radius:18px}
.item{padding:18px 18px 20px}
.item:hover{border-color:rgba(255,59,74,.75);box-shadow:0 4px 16px rgba(0,0,0,.4),0 0 18px rgba(225,29,46,.3),inset 0 1px 0 rgba(255,255,255,.18)}
.art{height:130px;display:grid;place-items:center;margin-bottom:12px}
.ring{width:84px;height:84px;border-radius:50%;border:12px solid var(--red)}
.watch{width:92px;height:92px;border-radius:50%;border:6px solid var(--gray);display:grid;place-items:center;position:relative}
.watch::before{content:"";width:3px;height:30px;background:var(--red-hi);position:absolute;bottom:50%;transform-origin:bottom}
.watch::after{content:"";width:22px;height:3px;background:var(--ink);position:absolute;right:50%}
.chain{width:110px;height:70px;border:8px dotted var(--gray);border-top:none;border-radius:0 0 60px 60px}
.band{width:110px;height:56px;border:10px solid var(--red);border-radius:28px}
.belt{width:120px;height:24px;background:var(--gray);position:relative;border-radius:2px}
.belt::after{content:"";position:absolute;left:50%;top:-6px;width:28px;height:36px;border:5px solid var(--red);transform:translateX(-50%)}
.wallet{width:100px;height:68px;background:#2b2c30;border:1px solid var(--gray);border-radius:6px;position:relative}
.wallet::after{content:"";position:absolute;left:0;top:22px;width:100%;height:3px;background:var(--red)}
.item h3{font-size:19px;font-weight:600}
.price{color:var(--muted)}
section{padding:56px 0}
.about{background:rgba(255,255,255,.02);border-top:1px solid rgba(255,255,255,.08);border-bottom:1px solid rgba(255,255,255,.08)}
.about p{max-width:36em;color:var(--muted)}
.vals{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:24px;margin-top:28px}
.vals>div{padding:20px}
.vals h3{font-size:18px;color:var(--red-hi)}
.vals p{font-size:16px}
.phone{display:block;margin-top:18px;color:var(--muted);direction:ltr;text-align:right}
footer{padding:36px 0 44px;color:var(--muted);display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px}
.socials{position:relative;display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:22px}
.socials.bottom{justify-content:flex-start;margin-top:36px}
.soc{display:inline-flex;align-items:center;gap:8px;padding:8px 16px;border-radius:14px;text-decoration:none;font-weight:600;font-size:15px;background:linear-gradient(145deg,rgba(255,255,255,.12),rgba(255,255,255,.03));border:1px solid rgba(255,255,255,.16);box-shadow:0 3px 10px rgba(0,0,0,.4),inset 0 1px 0 rgba(255,255,255,.18)}
.soc:hover{border-color:rgba(255,59,74,.75);box-shadow:0 3px 10px rgba(0,0,0,.4),0 0 14px rgba(225,29,46,.35),inset 0 1px 0 rgba(255,255,255,.18)}
.soc:hover .ic{color:var(--red-hi)}
.ic{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
@media (max-width:560px){nav{gap:14px;font-size:15px}}
@media (prefers-reduced-motion:no-preference){.btn{transition:transform .15s}.btn:hover{transform:translateY(-2px)}}
.btn:active,.soc:active{transform:scale(.97)}
#lk[hidden]{display:none}
#lk{position:fixed;left:12px;right:12px;bottom:calc(12px + env(safe-area-inset-bottom,0px));z-index:50;max-width:420px;margin:0 auto;padding:16px;border-radius:16px;background:#1b1b1e;border:1px solid rgba(255,255,255,.18);box-shadow:0 8px 24px rgba(0,0,0,.6)}
#lk p{font-size:15px;margin-bottom:10px;line-height:1.7}
#lk input{width:100%;padding:10px;border-radius:10px;border:1px solid var(--gray);background:#0c0c0d;color:var(--ink);font:inherit;font-size:14px;direction:ltr}
#lk .row{display:flex;gap:8px;margin-top:10px}
#lk button{flex:1;padding:10px;border-radius:10px;border:0;background:var(--red);color:#fff;font:inherit;font-weight:800;cursor:pointer}
#lk button[data-a=close]{background:#2b2c30}
@media (min-width:900px) and (hover:hover){.item,.vals>div,header,.soc{-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px)}}
</style>
</head>
